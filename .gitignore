# Built place files. `rojo build` regenerates these from src at any time, and
# they are large binaries that change on every build - the source is the
# truth. NOTE: assets/Assets.rbxm is NOT built and MUST stay committed; it
# holds the Studio-uploaded mesh ids that no script can reproduce.
/build/
*.rbxl
*.rbxm.lock

# Claude Code's per-machine settings (permissions etc.) - local, not shared.
.claude/settings.local.json

