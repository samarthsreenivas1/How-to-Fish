# Line endings: LF everywhere, on every machine.
#
# This project is edited from Windows and macOS, and the toolchain
# (stylua in particular) rewrites whole files. Without this, a checkout on
# one machine can convert every line, and the next `stylua src` turns that
# into a diff touching every line of every file. Pinning LF means a commit
# from either machine shows only what actually changed.
* text=auto eol=lf

*.luau text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.sh    text eol=lf

# Binaries: never touch the bytes, never try to diff them.
#
# assets/Assets.rbxm matters most - it is the Studio import result carrying
# the uploaded mesh ids, cannot be regenerated by any script, and would be
# destroyed by line-ending conversion.
*.rbxm  binary
*.rbxl  binary
*.rbxlx binary
*.glb   binary
*.blend binary
*.png   binary
*.jpg   binary
*.wav   binary
*.mp3   binary
