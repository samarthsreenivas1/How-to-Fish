--!nonstrict
-- Lava.luau
-- The volcano lava's stylised look, in one place so the client LavaController
-- reads a single source (mirrors Ocean.luau for the water).
--
-- The "yellow lava" texture is generated by assets/lava_gen.py. Like the water
-- texture, Rojo can't sync images, so it's uploaded once:
--   Studio > View > Asset Manager > Import > assets/lava.png, then paste the
--   image's asset id into TEXTURE_ID below. See assets/README.md.
--
-- It's applied through a MaterialVariant (LavaController), which tiles the
-- image across the lava mesh by studs - no UVs and no re-import needed. Until
-- the id is set the lava falls back to a flat bright molten colour.

local Lava = {}

Lava.TEXTURE_ID = 126326292788135 -- rbxassetid of the uploaded assets/lava.png; 0 = not uploaded yet
Lava.STUDS_PER_TILE = 48 -- how many studs one copy of the tile covers on the lava (bigger = larger plates)
Lava.TINT = Color3.fromRGB(255, 255, 255) -- multiplies the texture; white shows it as authored
Lava.FALLBACK_COLOR = Color3.fromRGB(255, 168, 28) -- bright molten orange (Neon) shown until the texture is uploaded

return Lava
