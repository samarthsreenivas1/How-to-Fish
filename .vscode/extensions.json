{
	// Suggested when the folder is opened. VS Code will offer to install them
	// all in one click ("Show Recommendations" -> Install).
	"recommendations": [
		// Luau language server: types, autocomplete, go-to-definition, and
		// inline errors. It reads sourcemap.json (autogenerated from
		// default.project.json - see .vscode/settings.json) so that
		// `require(script.Parent.Foo)` resolves to the real file.
		"johnnymorganz.luau-lsp",

		// The project's formatter. Pinned to 2.5.2 by aftman.toml; the
		// settings point the extension at the PATH binary so VS Code formats
		// exactly the way `stylua src` does.
		"johnnymorganz.stylua",

		// The project's linter (selene 0.31.0), inline as you type.
		"kampfkarren.selene-vscode",

		// Start/stop `rojo serve` and install the Studio plugin from the
		// command palette, instead of a separate terminal.
		"evaera.vscode-rojo",

		// Claude Code in the editor.
		"anthropic.claude-code"
	]
}
